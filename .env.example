# Local development values. NEVER reuse these keys on a live network.
CHAIN_ID=31337
RPC_URLS=http://127.0.0.1:8545
# Hardhat dev account #0 (public test key)
FREE_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN_TOKEN=change-me
ALLOW_INSECURE_WEBHOOKS=1

# Coin payments: a network is payable only when its receiving address is set
# TREASURY_BITCOIN=bc1...
# TREASURY_LITECOIN=ltc1...
# TREASURY_TRON=T...
# TREASURY_SOLANA=...
# TREASURY_ETHEREUM=0x...
# EVM_RPC_ETHEREUM=https://...
# TRON_API_KEY=
# SOLANA_RPC=https://...
# PUBLIC_RPC_URL=https://...
# CHAIN_EXPLORER=https://basescan.org
# TRUST_PROXY=1

# Email (self-hosted). 'file' writes .eml files for local development.
MAIL_TRANSPORT=file
MAIL_FROM="ADDR <login@localhost>"
# MAIL_TRANSPORT=direct              # deliver straight to recipients' MX (port 25 open, DNS set up)
# DKIM_KEY_FILE=data/dkim-addr.pem   # from: node scripts/mail-keys.cjs yourdomain.com
# DKIM_SELECTOR=addr
# MAIL_HELO=mail.yourdomain.com
# MAIL_TRANSPORT=relay SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS=
ADMIN_EMAILS=you@yourdomain.com
# PUBLIC_URL=https://addr.yourdomain.com   # used in sign-in links, enables Secure cookies
